# ==========================================
# EasyGo Backend Production Environment Variables
# ==========================================

# Database & Cache
DATABASE_URL="postgresql://postgres:password@localhost:5432/easygo_db?schema=public"
REDIS_URL="redis://:password@localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
ADMIN_API_KEY="easygo-admin-secret-key-change-in-production"

# Server & Network Configuration
APP_PORT=3000
APP_ENV="development" # or "production"
CORS_ORIGIN="*"

# GPS Ingestion & Hardware Integration
GPS_API_BASE_URL="https://api.easygo.yourdomain.com"
GPS_DEVICE_SECRET="dev-tracker-secret-key-001"
TRACKER_API_KEY="dev-tracker-secret-key-001"
GPS_MAX_ACCURACY_METERS=100

# WebSocket Real-Time Broadcasting
WEBSOCKET_URL="wss://api.easygo.yourdomain.com"

# OTP Settings (mock for development)
OTP_EXPIRY_SECONDS=300
MOCK_OTP=123456

# Simulator Settings (disable in production)
SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_MS=3000
SIMULATOR_SPEED_KMPH=40

# Offline & Stop Engine Thresholds
BUS_OFFLINE_THRESHOLD_SECONDS=60
APPROACHING_STOP_RADIUS_KM=0.3
AT_STOP_RADIUS_KM=0.05
STOP_DWELL_TIME_SECONDS=20
