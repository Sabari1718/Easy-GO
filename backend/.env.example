DATABASE_URL="postgresql://postgres:password@localhost:5432/easygo_db?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
APP_PORT=3000
APP_ENV=development
CORS_ORIGIN=*

# GPS Tracker Authentication
TRACKER_API_KEY=tracker-secret-key-change-in-production

# OTP Settings (mock for development)
OTP_EXPIRY_SECONDS=300
MOCK_OTP=123456

# Simulator Settings
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=3000
SIMULATOR_SPEED_KMPH=40

# Offline Detection
BUS_OFFLINE_THRESHOLD_SECONDS=60

# Stop Detection
APPROACHING_STOP_RADIUS_KM=0.3
AT_STOP_RADIUS_KM=0.05
STOP_DWELL_TIME_SECONDS=20
